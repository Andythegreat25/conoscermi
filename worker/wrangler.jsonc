{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conoscermi-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "FIREBASE_PROJECT_ID": "conoscermi-c2a00",
    "ALLOWED_ORIGINS": "https://conoscermi-c2a00.web.app,https://conoscermi-c2a00.firebaseapp.com",
    "VAPID_PUBLIC_KEY": "BFM4ZtuaoVPNeDjyLxFnJJpG-B9n0mIkOD_x0eHVMTUduL8MaUoqjsQMizyeRKJoEwmXE_7MZpiCeeuljEDcW1g",
    "VAPID_SUBJECT": "https://conoscermi-c2a00.web.app"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "conoscermi-push",
      "database_id": "f31ac3c2-2c62-4e7c-a82b-c1884c93e472",
    "migrations_dir": "migrations"
  }],
  "triggers": {
    "crons": ["0 * * * *"]
